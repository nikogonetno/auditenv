{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "findings.schema.json",
  "title": "findings.json, the object of submit (case §05, SPEC §5.1)",
  "description": "Extra keys are ignored at both levels. Not expressible here: episode_id must equal the episode's own id (else episode_id_mismatch).",
  "type": "object",
  "required": ["episode_id", "findings"],
  "properties": {
    "episode_id": {"type": "string"},
    "findings": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["type", "affected_ids", "claimed_amount_minor", "currency", "evidence_ids", "explanation"],
      "properties": {
        "type": {"enum": ["duplicate_invoice", "payment_allocation", "fx_rate", "period_cutoff"]},
        "affected_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "claimed_amount_minor": {"type": "integer", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "evidence_ids": {"type": "array", "maxItems": 10, "items": {"type": "string"}},
        "explanation": {"type": "string", "maxLength": 1000}
      }
    }
  }
}
